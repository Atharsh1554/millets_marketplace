# ── Database (PostgreSQL) ──────────────────────────────────────────────
# Any PostgreSQL 14+ works (local install, Docker, Neon, Supabase, RDS…):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/millet_market?schema=public"
#
# Zero-install local dev option: `npm run db:local` starts an embedded PGlite server on :5433.
# PGlite multiplexes one session, so it needs pgbouncer=true (disables named prepared statements).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

# ── Auth ───────────────────────────────────────────────────────────────
# Random string, at least 32 characters. Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── File storage ───────────────────────────────────────────────────────
# local (dev only: writes to public/uploads) | supabase | cloudinary | s3  (see src/server/storage/index.ts)
STORAGE_DRIVER="local"
# Supabase Storage (when STORAGE_DRIVER="supabase"). Use a PUBLIC bucket. The service-role key is server-only.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="uploads"
# CLOUDINARY_URL=""
# S3_BUCKET="" / S3_REGION="" / AWS_ACCESS_KEY_ID="" / AWS_SECRET_ACCESS_KEY=""

# ── Payments ───────────────────────────────────────────────────────────
# mock (development/demo — no money moves) | razorpay (see src/server/payments/index.ts)
PAYMENT_PROVIDER="mock"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# ── Organisation contact ───────────────────────────────────────────────
# Phone number farmers reach with the "Call Now" button on hardware pages.
# Leave empty to hide the button.
ORG_CONTACT_PHONE=""

# ── UI ─────────────────────────────────────────────────────────────────
# Shows the "Demo environment" banner. Set to "false" in production.
NEXT_PUBLIC_DEMO_MODE="true"
